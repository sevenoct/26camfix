<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>entry</key>
	<dict>
		<key>cell</key><string>PSLinkCell</string>
		<key>label</key><string>CamFull</string>
	</dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>CamFull</string>
			<key>footerText</key><string>Pendamping 26Cam (Legacy) untuk iPhone 7. Perubahan langsung diterapkan; kalau belum, tutup paksa Kamera.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Aktifkan CamFull</string>
			<key>key</key><string>Enabled</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Foto</string>
			<key>footerText</key><string>Layar penuh = preview 16:9 menutupi area di belakang tombol shutter. Matikan untuk kembali ke 4:3.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Foto layar penuh (16:9)</string>
			<key>key</key><string>FullPhoto</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>key</key><string>PhotoY</string>
			<key>default</key><real>0</real>
			<key>min</key><real>-60</real>
			<key>max</key><real>150</real>
			<key>showValue</key><true/>
			<key>isContinuous</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Video, Square, Aspect</string>
			<key>footerText</key><string>Video layar penuh menghilangkan strip hitam bawah. Perbaikan Square merapatkan preview ke kotak square. Eksperimen: tombol ASPECT di sheet 26Cam mengganti 4:3 / 16:9.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Video layar penuh</string>
			<key>key</key><string>FullVideo</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Perbaiki preview Square</string>
			<key>key</key><string>FixSquare</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Tombol ASPECT ganti 4:3/16:9 (eksperimen)</string>
			<key>key</key><string>AspectHook</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>Diagnosa</string>
			<key>footerText</key><string>Menampilkan teks hijau kecil di Kamera berisi mode dan posisi preview. Kalau teks ini tidak muncul, tweak tidak aktif di Kamera.</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>Tampilkan teks debug</string>
			<key>key</key><string>Debug</string>
			<key>default</key><true/>
			<key>defaults</key><string>com.hasan.camfull</string>
			<key>PostNotification</key><string>com.hasan.camfull/prefs</string>
		</dict>
	</array>
</dict>
</plist>
